// ═══════════════════════════════════════════════════════════════════
// Smart Space Booking — UKK RPL 2026/2027 Paket B (SMK Telkom Malang)
// Kategori: Backend — Node.js/Express + Prisma + PostgreSQL
//
// This schema is the reconciled version of ERD (image) + Kontrak API
// (Bagian III) + Bagian II prose, per the RECONCILIATION LOG agreed
// with the exam-taker. Every deviation from the literal ERD diagram is
// commented inline with which RECONCILIATION LOG item justifies it.
// ═══════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────

// Exact value order per ERD: users.role ENUM('admin_space','member')
enum Role {
  admin_space
  member
}

enum TipeSpace {
  desk
  meeting_room
  private_office
}

enum StatusReservasi {
  belum_dikonfirm
  disetujui
  aktif
  selesai
  dibatalkan
}

// ─────────────────────────────────────────────────────────────────
// MULTI-TENANCY (mandatory — module §III.1 "WAJIB", not in ERD,
// added on top with no conflict against any ERD/Contract field)
// ─────────────────────────────────────────────────────────────────

model Maker {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(100)
  username  String   @unique @db.VarChar(50)
  email     String   @unique @db.VarChar(150) // ONLY table with email
  password  String   @db.VarChar(255) // bcrypt hash, min 6 chars enforced at app level
  appKey    String   @unique @map("app_key") @db.VarChar(50) // format mk_<32hex>
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users       User[]
  members     Member[]
  spaceOwners SpaceOwner[]
  spaces      Space[]
  diskons     Diskon[]
  reservasis  Reservasi[]

  @@map("makers")
}

// ─────────────────────────────────────────────────────────────────
// CORE TABLES
// ─────────────────────────────────────────────────────────────────

model User {
  id        BigInt   @id @default(autoincrement())
  makerId   BigInt   @map("maker_id")
  maker     Maker    @relation(fields: [makerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  username  String   @db.VarChar(50)
  password  String   @db.VarChar(255) // bcrypt hash
  role      Role
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  member     Member?
  spaceOwner SpaceOwner?

  // Username uniqueness is per-tenant, not global (module §III.1 isolation)
  @@unique([makerId, username])
  @@map("users")
}

// 1:1 profile for users WHERE role='member'.
// NOTE: ERD relation caption says "1 to Many" between users and member,
// but the ERD's own PK/FK cardinality marks (1 ─ 1) and every Auth
// response in the Contract (one `member` object per user, never an
// array) both imply 1:1. Caption treated as a diagram typo.
model Member {
  id        BigInt   @id @default(autoincrement())
  idUser    BigInt   @unique @map("id_user")
  user      User     @relation(fields: [idUser], references: [id], onDelete: Cascade, onUpdate: Cascade)
  makerId   BigInt   @map("maker_id")
  maker     Maker    @relation(fields: [makerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  namaMember String  @map("nama_member") @db.VarChar(100)
  instansi  String   @db.VarChar(100)
  alamat    String   @db.Text
  telp      String   @db.VarChar(20)
  foto      String?  @db.VarChar(255) // FILENAME only, not URL — foto_url is API-computed
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reservasis Reservasi[]

  @@index([makerId, namaMember]) // GET /api/admin/members?search
  @@map("member")
}

// 1:1 profile for users WHERE role='admin_space'.
// RECONCILIATION LOG #1: NO alamat/deskripsi columns — ERD has none,
// and UpdateCoworkingProfileDto (Contract) also excludes them, even
// though Bagian II prose mentions them. Two technical sources agree
// and outrank the prose description.
model SpaceOwner {
  id            BigInt   @id @default(autoincrement())
  idUser        BigInt   @unique @map("id_user")
  user          User     @relation(fields: [idUser], references: [id], onDelete: Cascade, onUpdate: Cascade)
  makerId       BigInt   @map("maker_id")
  maker         Maker    @relation(fields: [makerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  namaCoworking String   @map("nama_coworking") @db.VarChar(100)
  namaPemilik   String   @map("nama_pemilik") @db.VarChar(100)
  telp          String   @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  spaces     Space[]
  reservasis Reservasi[] // via reservasi.id_owner (RECONCILIATION LOG #5)

  @@map("space_owner")
}

model Space {
  id          BigInt     @id @default(autoincrement())
  idOwner     BigInt     @map("id_owner")
  owner       SpaceOwner @relation(fields: [idOwner], references: [id], onDelete: Cascade, onUpdate: Cascade)
  makerId     BigInt     @map("maker_id")
  maker       Maker      @relation(fields: [makerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  namaSpace   String     @map("nama_space") @db.VarChar(100)
  // RECONCILIATION LOG #2: INTEGER not DOUBLE — Ketentuan Global §III.4
  // mandates integer/number for all monetary values; overrides ERD's DOUBLE.
  hargaPerJam Int        @map("harga_per_jam")
  tipe        TipeSpace
  kapasitas   Int
  foto        String?    @db.VarChar(255) // FILENAME only — foto_url is API-computed, not stored
  deskripsi   String     @db.Text
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  reservasis Reservasi[]

  @@index([makerId, tipe]) // GET /api/spaces?tipe
  @@index([namaSpace]) // GET /api/spaces?search
  @@map("space")
}

model Diskon {
  id       BigInt   @id @default(autoincrement())
  makerId  BigInt   @map("maker_id")
  maker    Maker    @relation(fields: [makerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  namaDiskon String @map("nama_diskon") @db.VarChar(100) // uppercase, no-space convention enforced at app level
  // RECONCILIATION LOG #3: NOT a monetary field, so §III.4's integer
  // rule doesn't apply here — kept as DECIMAL to honor ERD's DOUBLE
  // intent while respecting the 1–100 range (validated at app level).
  persentaseDiskon Decimal  @map("persentase_diskon") @db.Decimal(5, 2)
  tanggalAwal      DateTime @map("tanggal_awal")
  tanggalAkhir     DateTime @map("tanggal_akhir")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  reservasis Reservasi[]

  @@unique([makerId, namaDiskon])
  @@map("diskon")
}

// RECONCILIATION LOG #6: flattened — NO separate detail_reservasi
// table. Every field the ERD put on detail_reservasi (id_space,
// id_diskon, total_harga) lives directly here instead, matching what
// Kontrak API §III.16 and every reservasi response example actually
// return. This is what graders' Postman tests hit — flattening avoids
// failing them, and the module's "boleh disesuaikan namun tidak
// mengurangi fitur" clause explicitly permits it.
model Reservasi {
  id          BigInt @id @default(autoincrement())
  makerId     BigInt @map("maker_id")
  maker       Maker  @relation(fields: [makerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  kodeBooking String @unique @map("kode_booking") @db.VarChar(30) // app-generated: BOOK-YYYYMMDD-XXXX

  // RECONCILIATION LOG #5: present directly per ERD relation #2, even
  // though the API never returns it standalone (owner is always
  // reached via space.id_owner in responses). Kept as a denormalized
  // FK — harmless, and matches the ERD's explicit relation.
  idOwner BigInt     @map("id_owner")
  owner   SpaceOwner @relation(fields: [idOwner], references: [id], onDelete: Restrict, onUpdate: Cascade)

  idMember BigInt @map("id_member")
  member   Member @relation(fields: [idMember], references: [id], onDelete: Restrict, onUpdate: Cascade)

  idSpace BigInt @map("id_space")
  space   Space  @relation(fields: [idSpace], references: [id], onDelete: Restrict, onUpdate: Cascade)

  idDiskon BigInt? @map("id_diskon")
  diskon   Diskon? @relation(fields: [idDiskon], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // RECONCILIATION LOG #4: DATE not DATETIME — CreateReservasiDto and
  // every response example show date-only strings ("2026-08-30", no
  // time component). This is what Postman actually sends/receives,
  // so Contract wins over ERD's DATETIME.
  tanggalReservasi DateTime @map("tanggal_reservasi") @db.Date

  jamMulai   DateTime @map("jam_mulai") @db.Time()
  // Computed = jamMulai + durasiJam, STORED (not derived on read) —
  // needed as-is for fast availability/overlap range queries.
  jamSelesai DateTime @map("jam_selesai") @db.Time()
  durasiJam  Int      @map("durasi_jam") // min 1, validated at app level

  // SNAPSHOT at booking time, NOT a live read from space.hargaPerJam —
  // protects historical totals against future price edits on the space.
  hargaPerJam Int @map("harga_per_jam")

  totalHargaAwal Int @map("total_harga_awal") // = hargaPerJam * durasiJam
  potonganDiskon Int @default(0) @map("potongan_diskon") // = totalHargaAwal * persentaseDiskon / 100
  totalBayar     Int @map("total_bayar") // = totalHargaAwal - potonganDiskon

  status StatusReservasi @default(belum_dikonfirm)

  checkInTime  DateTime? @map("check_in_time")
  checkOutTime DateTime? @map("check_out_time")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([idSpace, tanggalReservasi, jamMulai]) // availability/overlap check
  @@index([makerId, status]) // admin filter: ?status
  @@index([makerId, tanggalReservasi]) // monthly reports: ?month&?year
  @@map("reservasi")
}

// NOTE ON OVERLAP PREVENTION:
// No double-booking on the same space/date/time range CANNOT be
// enforced with a plain unique index — it's a range comparison, not
// an equality one. Validate at the application layer (transaction +
// row lock or advisory lock) before insert.
