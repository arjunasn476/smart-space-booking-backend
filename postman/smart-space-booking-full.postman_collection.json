              "raw": "{\n  \"username\": \"johndoe\",\n  \"password\": \"Secret123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data;",
                  "  if (data.role === 'admin_space') {",
                  "    pm.collectionVariables.set('adminToken', data.access_token);",
                  "    console.log('Saved adminToken (role: admin_space)');",
                  "  } else if (data.role === 'member') {",
                  "    pm.collectionVariables.set('memberToken', data.access_token);",
                  "    console.log('Saved memberToken (role: member)');",
                  "  }",
                  "}"
                ]
